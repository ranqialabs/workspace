{
  "name": "bob",
  "version": "0.0.0",
  "private": true,
  "description": "Bob: GitHub, Linear and an LLM agent in Discord and Slack, on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "wrangler types --check && oxlint && oxfmt --check && bun test",
    "postinstall": "[ -n \"$CI\" ] || prek install",
    "test": "bun test",
    "docs": "uvx zensical@0.0.70 serve",
    "docs:build": "uvx zensical@0.0.70 build --clean",
    "secrets:push": "bash scripts/push-secrets.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.92",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "ai": "^7.0.138",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@j178/prek": "^0.5.5",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
