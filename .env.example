# Copy to .env for local runs. Never commit .env.
# In production: GITHUB_ORG lives in fly.toml [env]; secrets via `fly secrets`.

# --- Non-secret ---
GITHUB_ORG=ranqialabs

# --- Secrets ---
DISCORD_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=            # PEM contents, or a path to the .pem file
GITHUB_WEBHOOK_SECRET=
OPENAI_API_KEY=                    # /issue is disabled without it

# --- Linear (optional) ---
# An OAuth2 application under Linear -> Settings -> API, with client credentials
# enabled and the `read` scope. Set both or neither: one alone cannot mint a token,
# and the bot logs a warning and switches Linear off. Without them the Linear tools
# say Linear isn't configured and everything else runs unchanged.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# --- Network (optional, defaults shown) ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Optional ---
# Any pydantic-ai model string; unset uses the default in config.py.
# AGENT_MODEL=
