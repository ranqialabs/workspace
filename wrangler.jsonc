{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bob",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Which version is running, so bob can say when a deploy of its own is live.
  "version_metadata": { "binding": "VERSION" },
  "durable_objects": {
    "bindings": [
      // One per org: configuration, news cards and access.
      { "name": "WORKSPACE", "class_name": "Workspace" },
      // The one Discord gateway connection.
      { "name": "GATEWAY", "class_name": "Gateway" },
      // One per conversation with the agent: its history, queue and drafts.
      { "name": "CONVERSATION", "class_name": "Conversation" },
      // One per org: the outside services' MCP connections and OAuth tokens.
      { "name": "SERVICES", "class_name": "Services" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Workspace", "Gateway", "Conversation"] },
    { "tag": "v2", "new_sqlite_classes": ["Services"] },
  ],
  // Reconnects the gateway after a deploy or a fatal close.
  // The fonts the retro image is drawn with.
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "secrets": { "required": ["GITHUB_APP_ID", "GITHUB_APP_PRIVATE_KEY", "GITHUB_WEBHOOK_SECRET"] },
  "vars": {
    // The GitHub org whose repos, people and checks bob follows.
    "GITHUB_ORG": "ranqialabs",
    // bob's own repo: its deploys are announced, for a few minutes, in its home channel.
    "BOB_REPO": "ranqialabs/workspace",
    // Where bob answers on the web, for the OAuth callbacks of the services it connects to.
    "PUBLIC_URL": "https://bob.ranqia.workers.dev",
    // The DeepSeek model behind the agent, the retro and the news notes.
    "AGENT_MODEL": "deepseek-v4-flash",
    // The team's time zone: reminders go out on its working days and hours,
    // and the retro's days and weeks are its own.
    "TIMEZONE": "America/Sao_Paulo",
  },
}
