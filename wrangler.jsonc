{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bob",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "secrets": { "required": ["GITHUB_APP_ID", "GITHUB_APP_PRIVATE_KEY", "GITHUB_WEBHOOK_SECRET"] },
  "vars": {
    // The GitHub org whose repos, people and checks bob follows.
    "GITHUB_ORG": "ranqialabs",
  },
}
